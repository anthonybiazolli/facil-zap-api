# ============================================
# FACIL ZAP API - Environment Configuration
# ============================================

# Database Configuration
DB_USER=facilzap
DB_PASSWORD=your_secure_password_here
DB_NAME=facilzap_db
DB_URL=postgresql://facilzap:your_secure_password_here@postgres:5432/facilzap_db

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# MongoDB Configuration
MONGO_USER=facilzap
MONGO_PASSWORD=your_mongo_password_here
MONGO_DB=facilzap_analytics
MONGODB_URL=mongodb://facilzap:your_mongo_password_here@mongodb:27017/facilzap_analytics?authSource=admin

# MinIO Configuration
MINIO_USER=facilzap
MINIO_PASSWORD=your_minio_password_here

# Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
API_KEY_SALT=your_api_key_salt_here
ENCRYPTION_KEY=your_encryption_key_here_min_32_chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# External Services
ZAPSIGN_API_KEY=your_zapsign_api_key
ZAPSIGN_WEBHOOK_SECRET=your_zapsign_webhook_secret

# PIX Configuration
PIX_API_KEY=your_pix_api_key
PIX_CLIENT_ID=your_pix_client_id
PIX_CLIENT_SECRET=your_pix_client_secret
PIX_WEBHOOK_SECRET=your_pix_webhook_secret

# Webhook URL
WA_WEBHOOK_URL=https://your-domain.com/webhooks/whatsapp

# Node Environment
NODE_ENV=production
