{
  "name": "facil-zap-api",
  "version": "2.0.0",
  "description": "Microserviços de Automação WhatsApp com Anti-Ban 2.0, Compliance Legal e PIX Zero Taxa",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "docker-compose up --build",
    "dev:detach": "docker-compose up --build -d",
    "stop": "docker-compose down",
    "logs": "docker-compose logs -f",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "setup": "bash scripts/setup.sh",
    "clean": "docker-compose down -v && docker system prune -f"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prisma": "5.10.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@prisma/client": "5.10.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facilzap/facil-zap-api.git"
  },
  "keywords": [
    "whatsapp",
    "api",
    "microservices",
    "automation",
    "anti-ban",
    "pix",
    "compliance",
    "zapsign"
  ],
  "author": "Facil Zap Team",
  "license": "PROPRIETARY"
}